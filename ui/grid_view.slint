import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component GridView inherits Rectangle {
    in property <[image]> images;
    in property <[int]> statuses;
    in property <int> view-filter; // 0: All, 1: Accepted, 2: Rejected
    
    callback image-clicked(int);

    background: Theme.background;

    ScrollView {
        width: 100%;
        height: 100%;

        animate viewport-y {
            duration: 400ms;
            easing: cubic-bezier(0.2, 1, 0.2, 1);
        }
        
        VerticalLayout {
            padding: 20px;
            spacing: 20px;
            alignment: start;
            width: 100%;
            
            // Chunked loop to simulate a grid. 6 items per row for better width usage.
            for i in Math.ceil(root.images.length / 6) : HorizontalLayout {
                spacing: 15px;
                padding: 5px;
                alignment: start;
                width: 100%;
                
                for j in 6 : Rectangle {
                    property <int> idx: i * 6 + j;
                    // Items grow to fill width
                    min-width: 150px;
                    horizontal-stretch: 1;
                    height: self.width; 
                    
                    background: #2a2a2a;
                    border-radius: 8px;
                    clip: true;
                    visible: idx < root.images.length;
                    
                    // Filtering logic
                    property <bool> is-visible: (root.view-filter == 0) || 
                                              (root.view-filter == 1 && root.statuses[idx] == 1) ||
                                              (root.view-filter == 2 && root.statuses[idx] == 2);

                    if (idx < root.images.length && is-visible) : Image {
                        source: root.images[idx];
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                    
                    if (idx < root.images.length && is-visible && root.statuses[idx] != 0) : Rectangle {
                        x: parent.width - 24px;
                        y: 8px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: root.statuses[idx] == 1 ? Theme.success : Theme.danger;
                        border-width: 2px;
                        border-color: white;
                    }

                    if (idx < root.images.length && is-visible) : TouchArea {
                        clicked => { root.image-clicked(idx); }
                    }
                }
            }
        }
    }
}
