export global Theme {
    out property <color> background: #121212;
    out property <color> sidebar: #1e1e1e;
    out property <color> text: #e0e0e0;
    out property <color> text-dim: #a0a0a0;
    out property <color> accent: #007acc;
    out property <color> success: #4caf50;
    out property <color> danger: #f44336;
}

export component KeyboardHint inherits Rectangle {
    in property <string> key;
    in property <string> label;
    
    height: 24px;
    
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 45px;
            background: #333;
            border-radius: 4px;
            border-width: 1px;
            border-color: #555;
            Text {
                text: key;
                color: Theme.text;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: label;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}
