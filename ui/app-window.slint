import { Theme } from "theme.slint";
import { Sidebar } from "sidebar.slint";
import { Filmstrip } from "filmstrip.slint";
import { FilterBar } from "filter_bar.slint";
import { GridView } from "grid_view.slint";
import { ExportPopup } from "export_popup.slint";

export { Theme }

// This is the main application window definition
export component AppWindow inherits Window {
    title: "Photo Culler";
    min-width: 1024px;
    min-height: 768px;
    background: Theme.background;

    // --- RUST INTERFACE ---
    in-out property <float> brightness_val: 0;
    in-out property <float> contrast_val: 1.0;
    in-out property <int> selected_index: 0;
    in-out property <int> view_filter: 0; // 0: All, 1: Accepted, 2: Rejected
    in-out property <int> view_mode: 0; // 0: Single, 1: Grid
    in-out property <bool> is_scherm: false;
    in property <int> photo_count: 0;
    in property <string> selected_photo_filename: "";

    in-out property <bool> show_export_popup: false;
    in-out property <string> export_output_directory: "";

    in property <image> current_image;
    in property <[image]> filmstrip_images;
    in property <[int]> filmstrip_statuses;
    in property <[int]> filmstrip_visible_indices;

    // Callbacks
    callback next_photo();
    callback prev_photo();
    callback select_photo(int);
    callback settings_changed(float, float);
    callback load_raw();

    callback accept_photo();
    callback reject_photo();
    callback clear_filter();
    callback scherm_photo(bool);
    callback set_view_filter(int);
    callback start_export(string);
    callback browse_export_dir();

    // Navigation and Scrolling logic
    function navigate_right() {
        root.next_photo();
    }

    function navigate_left() {
        root.prev_photo();
    }

    // Keyboard handler
    FocusScope {
        init => {
            self.focus();
        }
        key-pressed(event) => {
            // View mode toggle
            if (event.text == "v" || event.text == "V") {
                root.view_mode = root.view_mode == 0 ? 1 : 0;
                return accept;
            }
            if (root.view_mode == 0) {
              // Navigation
              if (event.text == Key.RightArrow || event.text == "k") {
                    root.navigate_right();
                    return accept;
                }
                if (event.text == Key.LeftArrow || event.text == "j") {
                    root.navigate_left();
                    return accept;
                }

              // Set filters (only in single mode)
                if (event.text == "a" || event.text == "A") {
                    root.accept_photo();
                    return accept;
                }
                if (event.text == "r" || event.text == "R") {
                    root.reject_photo();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    root.scherm_photo(true);
                    return accept;
                }
                if (event.text == "q" || event.text == "Q") {
                    root.load_raw();
                    return accept;
                }
            }
            return reject;
        }

        HorizontalLayout {
            padding: 0px;
            spacing: 0px;

            // --- LEFT: Main View Area ---
            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                FilterBar {
                    view-mode: root.view_mode;
                    active-view-filter <=> root.view_filter;
                    selected-photo-status: root.filmstrip_statuses.length > root.selected_index ? root.filmstrip_statuses[root.selected_index] : 0;
                    photo-filename: root.selected_photo_filename;
                    is-scherm: root.is_scherm;
                    set-view-filter(f) => {
                        root.set_view_filter(f);
                    }
                    accept => {
                        root.accept_photo();
                    }
                    reject => {
                        root.reject_photo();
                    }
                    clear => {
                        root.clear_filter();
                    }
                    toggle-scherm => {
                        root.is_scherm = !root.is_scherm;
                        root.scherm_photo(root.is_scherm);
                    }
                }

                if (root.view_mode == 0): VerticalLayout {
                    // Main Image View Area
                    Rectangle {
                        background: #000;
                        clip: true;

                        Image {
                            source: root.current_image;
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }
                    }

                    filmstrip := Filmstrip {
                        images: root.filmstrip_images;
                        statuses: root.filmstrip_statuses;
                        visible_indices: root.filmstrip_visible_indices;
                        selected-index <=> root.selected_index;
                        select-photo(i) => {
                            root.select_photo(i);
                        }
                    }
                }

                if (root.view_mode == 1): GridView {
                    images: root.filmstrip_images;
                    statuses: root.filmstrip_statuses;
                    view-filter: root.view_filter;
                    image-clicked(idx) => {
                        root.selected_index = idx;
                        root.view_mode = 0;
                        root.select_photo(idx);
                    }
                }
            }

            Sidebar {
                view-mode: root.view_mode;
                toggle-view-mode => {
                    root.view_mode = root.view_mode == 0 ? 1 : 0;
                }
                export-clicked => {
                    root.show_export_popup = true;
                }
                selected-index: root.selected_index;
                photo-count: root.photo_count;
                brightness-val <=> root.brightness_val;
                contrast-val <=> root.contrast_val;
                settings-changed(b, c) => {
                    root.settings_changed(b, c);
                }
                load-raw => {
                    root.load_raw();
                }
            }
        }

        if (root.show_export_popup): ExportPopup {
            output-directory <=> root.export_output_directory;
            close => {
                root.show_export_popup = false;
            }
            browse => {
                root.browse_export_dir();
            }
            export(dir) => {
                root.show_export_popup = false;
                root.start_export(dir);
            }
        }
    }
}

// A little helper global to format floats nicely in the UI
export global SlintUtils {
    pure callback float_to_string(float, int) -> string;
}
