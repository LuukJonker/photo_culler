import {
    Button,
    LineEdit,
    GroupBox,
    SpinBox,
    CheckBox,
} from "std-widgets.slint";
import { Theme } from "theme.slint";

export component ExportPopup inherits Rectangle {
    callback close();
    callback export(string, int, bool);
    callback browse();

    in-out property <string> output-directory: "";
    in-out property <int> quality: 80;

    background: #000000aa; // Semi-transparent overlay
    
    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: 500px;
        height: 400px;
        background: Theme.sidebar;
        border-radius: 8px;
        border-width: 1px;
        border-color: #444;

        // Prevent clicks inside from closing the popup
        TouchArea { }

        VerticalLayout {
            padding: 30px;
            spacing: 20px;
            alignment: center;

            Text {
                text: "EXPORT SETTINGS";
                color: Theme.accent;
                font-size: 20px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            GroupBox {
                title: "Output Configuration";
                VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "Output Directory:";
                        color: Theme.text;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        LineEdit {
                            text <=> root.output-directory;
                            placeholder-text: "Path to export directory...";
                            horizontal-stretch: 1;
                        }

                        Button {
                            text: "Browse...";
                            clicked => { root.browse(); }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 10px;

                Text {
                    text: "Quality";
                    color: Theme.text;
                    vertical-alignment: center;
                }

                // Should only be a number in the jpg quality range 1-100
                SpinBox {
                    value <=> root.quality;
                    minimum: 1;
                    maximum: 100;
                    step-size: 5;
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 10px;

                Text {
                    text: "Cull only";
                    color: Theme.text;
                    vertical-alignment: center;
                }

                cull_only_box := CheckBox { }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            HorizontalLayout {
                spacing: 20px;
                alignment: center;

                Button {
                    text: "Cancel";
                    clicked => { root.close(); }
                    width: 100px;
                }

                Button {
                    text: "Export";
                    primary: true;
                    enabled: root.output-directory != "";
                    clicked => { root.export(root.output-directory, root.quality, cull_only_box.checked); }
                    width: 150px;
                }
            }
        }
    }
}
